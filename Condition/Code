#GDD from Menoo
#convert air temp to stream water temp in deg C
# from eq. 2 in Mohseni, O., Erickson, T. R., & Stefan, H. G. (1997). A Non-Linear Regression Model for Weekly Stream Temperatures at 585 Gaging Stations in the US.
estimate_streamtemp = function(x){
  numerator = 26.7                           # values are median parameter values from Mohseni et al. Tbl X.
  denominator = 1 + (exp(0.16*(13.3 - x)))
  0.0 + (numerator/denominator)
}

gdd_conv <- gdd %>% 
  mutate(TMAX_conv = estimate_streamtemp(TMAX),
         TMIN_conv = estimate_streamtemp(TMIN),
         meanTemp = (TMAX_conv + TMIN_conv)/2, 
         GDD = ifelse(meanTemp - 10 > 0, meanTemp-10, 0),
         Date=as.Date(DATE, format="%m/%d/%Y"), #convert to date format in R
         GDD30 = zoo::rollsumr(GDD, k=30, fill=NA)) %>% 
  group_by(Year) %>% 
  mutate(cumulativeGDD = cumsum(GDD)) %>% 
  ungroup() 

cumu_gdd <- gdd_conv %>% 
  select(Date, cumulativeGDD, GDD30) %>% 
  filter(Date %in% unique(cat$Date-1)) %>% #keep the data for all days before (not including) to the date of capture
